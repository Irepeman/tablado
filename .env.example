# Tu clave de la API de Anthropic. Se usa SOLO en el servidor:
# nunca se envía al navegador y nunca aparece en el código del cliente.
# Consíguela en https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Peticiones al modelo por IP y hora. Protege tu factura en una URL pública.
RATE_LIMIT_PER_HOUR=30
